# Root .gitignore for E-Waste Passport

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment files and credentials
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build outputs and bundle artifacts
dist/
**/dist/
build/
**/build/
out/
**/out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage artifacts
coverage/
**/coverage/
*.lcov
.nyc_output/

# Runtime and cache
.cache/
.eslintcache
pids
*.pid
*.seed
*.pid.lock

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
