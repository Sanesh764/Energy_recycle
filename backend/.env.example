# ==============================================================================
# E-Waste Passport - AWS Elastic Beanstalk Environment Configuration Template
# ==============================================================================
# In Elastic Beanstalk, configure these variables in:
# AWS Console -> Elastic Beanstalk -> Configuration -> Updates, monitoring, and logging -> Platform Software -> Environment properties
# DO NOT COMMIT REAL PRODUCTION PASSWORDS OR SECRETS INTO VERSION CONTROL.
# ==============================================================================

# Node Environment ('production' for Elastic Beanstalk deployment)
NODE_ENV=production

# Application Port (Elastic Beanstalk maps Nginx proxy to port 5000 by default)
PORT=5000

# MongoDB Atlas Connection URI (Include credentials and database name)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/e-waste-passport?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_address>/e-waste-passport?retryWrites=true&w=majority

# Security: In production, ALLOW_DEV_DEMO_AUTH must ALWAYS be false.
# The server will refuse to start if set to true in production.
ALLOW_DEV_DEMO_AUTH=false

# Allowed Frontend Origins for CORS: set to your deployed Amplify frontend domain
# Defaults automatically allow https://main.d298fn45tbafnm.amplifyapp.com even if CORS_ORIGIN is customized
CORS_ORIGIN=https://main.d298fn45tbafnm.amplifyapp.com


# AWS Service Configuration
# When running on Elastic Beanstalk, instance IAM role handles S3 and Bedrock credentials.
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY SHOULD NOT BE HARDCODED.
AWS_REGION=us-east-1

# Amazon S3 Bucket Name for device photo uploads
S3_BUCKET_NAME=e-waste-passport-uploads-<unique-id>

# Amazon Bedrock Model ID (Default: Anthropic Claude 3 Haiku)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Amazon Cognito Configuration (Optional: fill if using Cognito user pools)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
