# ==============================================================================
# E-Waste Passport - Frontend Environment Variables
# ==============================================================================
# For AWS Amplify Hosting deployment:
# Configure in AWS Amplify Console -> App settings -> Environment variables:
# Key: VITE_API_BASE_URL
# Value: https://YOUR-ACTUAL-ELASTIC-BEANSTALK-URL/api
#
# NOTE: VITE_* variables are bundled into the client build.
# NEVER place AWS credentials, secret keys, or database passwords here.
# ==============================================================================

# Production pattern for AWS Amplify:
# VITE_API_BASE_URL=https://YOUR-ACTUAL-ELASTIC-BEANSTALK-URL/api

# Local Development default:
VITE_API_BASE_URL=http://localhost:5000/api

